# ============================================================
# VIZA HOME E.A.S - Variables de Entorno para Producción
# ============================================================
# Copia este archivo como .env y completa los valores.
# En Vercel, agregá estas variables en: Settings → Environment Variables.

# === BASE DE DATOS (Neon PostgreSQL) ===
# URL de conexión PostgreSQL (te la da Neon después de crear la base)
# Ejemplo: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://TU_USER:TU_PASSWORD@ep-TU-HOST.neon.tech/viza_home?sslmode=require"

# URL directa (sin pooler, para migraciones)
# Opcional, solo si querés separar directUrl de pooler URL
# DIRECT_URL="postgresql://TU_USER:TU_PASSWORD@ep-TU-HOST.neon.tech/viza_home?sslmode=require"

# === NEXTAUTH (Autenticación) ===
# URL pública de tu sitio (sin / al final)
# Ejemplo: https://viza.com.py  o  https://viza.vercel.app (subdominio free)
NEXTAUTH_URL="https://TU-DOMINIO.com"

# Secreto JWT - GENERÁ UNO ALEATORIO FUERTE
# Generar con: openssl rand -base64 32
# O en Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="CAMBIAME_POR_UN_SECRETO_ALEATORIO_DE_64_CHARS_HEX"

# === OPCIONAL: Rutas para Vercel ===
# Vercel detecta automáticamente Next.js, no hace falta configurar mucho.
# Pero si querés forzar build settings:
# NEXT_PUBLIC_APP_NAME="VIZA HOME E.A.S"
