# ============================================================
# VIZA HOME E.A.S - Variables de Entorno para Producción
# ============================================================
# Copia este archivo como .env y completa los valores.
# En Vercel, agregá estas variables en: Settings → Environment Variables.

# === BASE DE DATOS (Neon PostgreSQL) ===
# URL de conexión PostgreSQL (te la da Neon después de crear la base)
# Ejemplo: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://TU_USER:TU_PASSWORD@ep-TU-HOST.neon.tech/viza_home?sslmode=require"

# URL directa (sin pooler, para migraciones)
# Opcional, solo si querés separar directUrl de pooler URL
# DIRECT_URL="postgresql://TU_USER:TU_PASSWORD@ep-TU-HOST.neon.tech/viza_home?sslmode=require"

# === NEXTAUTH (Autenticación) ===
# URL pública de tu sitio (sin / al final)
# Ejemplo: https://viza.com.py  o  https://viza.vercel.app (subdominio free)
NEXTAUTH_URL="https://TU-DOMINIO.com"

# Secreto JWT - OBLIGATORIO en producción. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 32
# O en Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="CAMBIAME_POR_UN_SECRETO_ALEATORIO_DE_64_CHARS_HEX"

# === OPCIONAL: creación del primer administrador (scripts) ===
# Estas variables NO son necesarias para que la app funcione: solo las usan
# los scripts de seed/reset. Si no se definen, los scripts generan una
# contraseña aleatoria y la muestran una sola vez.
# SUPREMO_EMAIL="viza.cobranza@viza.com.py"
# SUPREMO_PASSWORD="una-clave-fuerte-de-12-o-mas-caracteres"
# SUPREMO_NOMBRE="Nombre Apellido"
# BOOTSTRAP_ADMIN_PASSWORD="otra-clave-fuerte"
# BOOTSTRAP_SUPREMO_PASSWORD="otra-clave-fuerte"
# SEED_ADMIN_PASSWORD="..."
# SEED_SUPREMO_PASSWORD="..."
# SEED_VENDEDOR_PASSWORD="..."

# === OPCIONAL: Rutas para Vercel ===
# Vercel detecta automáticamente Next.js, no hace falta configurar mucho.
# Pero si querés forzar build settings:
# NEXT_PUBLIC_APP_NAME="VIZA HOME E.A.S"

# ============================================================
# === BACKUP AUTOMÁTICO EXCEL POR CORREO (Task 112) ===
# ============================================================
# La base se exporta a Excel (.xlsx con una hoja por tabla) y se manda
# por correo 3 veces al día: 06:00, 14:00 y 22:00 (horario corregido
# por el dueño). En Vercel esto lo dispara Vercel Cron (ver vercel.json);
# en self-hosted (bun start / standalone) lo dispara node-cron desde
# instrumentation.ts.
#
# QUIÉN ENVÍA Y QUIÉN RECIBE (pedido del dueño, ya van por defecto
# dentro del código — estas dos variables son SOLO para cambiarlos
# algún día sin tocar código):
#   ENVÍA:  viza.cobranza@viza.com.py
#   RECIBE: viza@viza.com.py
# BACKUP_EMAIL_TO="viza@viza.com.py"
# SMTP_FROM="VIZA HOME Backup <viza.cobranza@viza.com.py>"

# Secreto que protege el endpoint /api/cron/backup-excel. Vercel Cron lo
# envía automáticamente como Authorization: Bearer <CRON_SECRET> si lo
# definís acá. Generá uno largo y aleatorio:
#   openssl rand -hex 32
CRON_SECRET="genera-un-secreto-aleatorio-de-64-chars-hex"

# SMTP: solo faltan estos 3 datos para que salga el correo.
# El usuario ya va por defecto (viza.cobranza@viza.com.py).
# La PASSWORD no se puede dejar escrita acá: el dueño la pone sola.
# Si viza.com.py usa Hostinger/cPanel, el host suele ser:
#   smtp.viza.com.py  (o el que indique el panel de su hosting)
SMTP_HOST="smtp.viza.com.py"
SMTP_PORT="465"
# SMTP_USER="viza.cobranza@viza.com.py"   (default ya en el código)
SMTP_PASS="PONER-AQUI-LA-PASSWORD-DE-viza.cobranza"

# Zona horaria del scheduler self-hosted (node-cron). Default Montevideo
# (UTC-3, sin DST). Paraguay también está en UTC-3 permanente desde
# oct/2024, así que los horarios son los mismos.
BACKUP_CRON_TZ="America/Montevideo"

# Para DESACTIVAR el scheduler self-hosted sin borrar código:
# BACKUP_CRON_ENABLED="false"


