  id               String      @id @default(cuid())
  sku              String      @unique
  name             String
  description      String?
  category         String?
  subcategory      String?
  brand            String?
  model            String?
  imageUrl         String?
  showInCatalog    Boolean     @default(true)
  obs              String?
  costBR           Float?
  rsToGs           Float?
  costUS           Float?
  usToGs           Float?
  costGs           Float?
  rsNoUS           Float?
  usNoGs           Float?
  subCost          Float?
  discountPct      Float?
  minusDisc        Float?
  addPct           Float?
  plusAdd          Float?
  admPct           Float?
  plusAdd2         Float?
  valorDesc        Float?
  minusDescV       Float?
  valorAdd         Float?
  costProd         Float?
  referencia       String?
  codViza          String?
  codShow          String?
  pct1A6           Float?
  pct7A13          Float?
  pct14A30         Float?
  marginContado    Float?
  marginC1         Float?
  marginC2         Float?
  marginC3         Float?
  marginC4         Float?
  marginC5         Float?
  marginC6         Float?
  marginC7         Float?
  marginC8         Float?
  marginC9         Float?
  marginC10        Float?
  marginC11        Float?
  marginC12        Float?
  marginC13        Float?
  marginC14        Float?
  marginC15        Float?
  marginC16        Float?
  marginC17        Float?
  marginC18        Float?
  marginC19        Float?
  marginC20        Float?
  marginC21        Float?
  marginC22        Float?
  marginC23        Float?
  marginC24        Float?
  marginC25        Float?
  marginC26        Float?
  marginC27        Float?
  marginC28        Float?
  marginC29        Float?
  marginC30        Float?
  priceContado     Float?
  price1           Float?
  price2           Float?
  price3           Float?
  price4           Float?
  price5           Float?
  price6           Float?
  price7           Float?
  price8           Float?
  price9           Float?
  price10          Float?
  price11          Float?
  price12          Float?
  price13          Float?
  price14          Float?
  price15          Float?
  price16          Float?
  price17          Float?
  price18          Float?
  price19          Float?
  price20          Float?
  price21          Float?
  price22          Float?
  price23          Float?
  price24          Float?
  price25          Float?
  price26          Float?
  price27          Float?
  price28          Float?
  price29          Float?
  price30          Float?
  safra            String?
  productName      String?
  fabricante       String?
  subGrupo         String?
  categoria        String?
  division         String?
  tipo             String?
  marca            String?
  modelo           String?
  valorTecnico     Float?
  margenTecnico    Float?
  coluna1          String?
  coluna2          String?
  stock            Int         @default(0)
  costSistema      Float?
  price            Float       @default(0)
  cost             Float       @default(0)
  etiquetaColor    String?
  ultimaEdicionAt  DateTime?
  ultimaEdicionPor String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  quoteItems       QuoteItem[]

  @@index([category])
  @@index([name])
  @@index([showInCatalog])
}

model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  vendorName      String      @default("Vendedor VIZA")
  notes           String?
  subtotal        Float
  discount        Float       @default(0)
  taxRate         Float       @default(0)
  total           Float
  status          String      @default("borrador")
  userId          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           QuoteItem[]

  @@index([userId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String
  productName String
  productSku  String
  quantity    Int      @default(1)
  unitPrice   Float
  subtotal    Float
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
