// Prisma schema - VIZA HOME E.A.S - Panel de Ventas
// Compatible con SQLite (desarrollo local) y PostgreSQL (Vercel+Neon producción)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite para desarrollo local, PostgreSQL para producción (Vercel+Neon)
  // El provider se elige automáticamente según la DATABASE_URL:
  //   - Si DATABASE_URL empieza con "file:" → SQLite
  //   - Si DATABASE_URL empieza con "postgresql:" o "postgres:" → PostgreSQL
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Para soportar también SQLite en desarrollo:
  // uncomment la siguiente línea para usar sqlite local
  // directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("colaborador") // "supremo_admin" | "admin" | "colaborador"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
  passwordLogs PasswordLog[]
}

// Bitácora de contraseñas - solo el SUPREMO_ADMIN puede verla
model PasswordLog {
  id                     String   @id @default(cuid())
  userId                 String
  email                  String
  contrasenaTextoPlano   String   // Contraseña legible para recuperación
  fechaCambio            DateTime @default(now())
  cambiadoPor            String   @default("SISTEMA") // "SISTEMA", "SUPREMO_ADMIN", "USUARIO"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String

  description   String?
  category      String?
  subcategory   String?
  brand         String?
  model         String?
  imageUrl      String?
  showInCatalog Boolean  @default(true)

  // B (col 2): OBS
  obs           String?
  // Costos (cols C..T)
  costBR       Float? // C - Costo R$ (input)
  rsToGs       Float? // D - R$ A GS (calc = C * 1100)
  costUS       Float? // E - Costo US$ (input)
  usToGs       Float? // F - US$ A GS (calc = E * 6000)
  costGs       Float? // G - Costo Gs (input)
  rsNoUS       Float? // H - R$ NO US$ (calc IF D>0, D, F)
  usNoGs       Float? // I - US$ NO GS (calc)
  subCost      Float? // J - Sub-Costo (= I o G)
  discountPct  Float? // K - % Descuento (input)
  minusDisc    Float? // L - MENOS DESC. % (calc = J - J*K)
  addPct       Float? // M - % Add (input)
  plusAdd      Float? // N - MAIS % ADD (calc = L + L*M)
  admPct       Float? // O - Gastos ADM (input)
  plusAdd2     Float? // P - MAIS % ADD 2 (calc = N + N*O)
  valorDesc    Float? // Q - Valor Descuento (input)
  minusDescV   Float? // R - MENOS DESC. V (calc = P - Q)
  valorAdd     Float? // S - Valor Add (input)
  costProd     Float? // T - Costo Prod. (calc ROUND((R+S)/1000)*1000)

  // Datos del producto (cols U..X)
  referencia   String? // U - REFERENCIA
  codViza      String? // V - COD VIZA (input, unique key - sku replica)
  codShow      String? // W - COD SHOW (input)
  // X - DESCRIPCION es `name`

  // Bases de porcentajes (cols Y..AA)
  pct1A6       Float? // Y - % 1 A 6 (input)
  pct7A13      Float? // Z - % 7 A 13 (input)
  pct14A30     Float? // AA - % 14 A 30 (input)

  // Márgenes (cols AB..BF) - AB input, AC..BF calculados
  marginContado Float? // AB - Contado (input initial margin)
  marginC1      Float? // AC - 1 Cuota (calc = AB + Y)
  marginC2      Float? // AD - 2 Cuota (calc = AC + Y)
  marginC3      Float? // AE - 3 Cuota
  marginC4      Float? // AF - 4 Cuota
  marginC5      Float? // AG - 5 Cuota
  marginC6      Float? // AH - 6 Cuota (último con Y)
  marginC7      Float? // AI - 7 Cuota (calc = AH + Z)
  marginC8      Float? // AJ - 8 Cuota
  marginC9      Float? // AK - 9 Cuota
  marginC10     Float? // AL - 10 Cuota
  marginC11     Float? // AM - 11 Cuota
  marginC12     Float? // AN - 12 Cuota
  marginC13     Float? // AO - 13 Cuota (último con Z)
  marginC14     Float? // AP - 14 Cuota (calc = AO + AA)
  marginC15     Float? // AQ - 15 Cuota
  marginC16     Float? // AR - 16 Cuota
  marginC17     Float? // AS - 17 Cuota
  marginC18     Float? // AT - 18 Cuota
  marginC19     Float? // AU - 19 Cuota
  marginC20     Float? // AV - 20 Cuota
  marginC21     Float? // AW - 21 Cuota
  marginC22     Float? // AX - 22 Cuota
  marginC23     Float? // AY - 23 Cuota
  marginC24     Float? // AZ - 24 Cuota
  marginC25     Float? // BA - 25 Cuota
  marginC26     Float? // BB - 26 Cuota
  marginC27     Float? // BC - 27 Cuota
  marginC28     Float? // BD - 28 Cuota
  marginC29     Float? // BE - 29 Cuota
  marginC30     Float? // BF - 30 Cuota (último con AA)

  // Precios finales (cols BG..CK) - todos calculados
  priceContado Float? // BG - Valor Al Contado
  price1       Float? // BH - Valor Cuota 1
  price2       Float? // BI - Valor Cuota 2
  price3       Float? // BJ - Valor Cuota 3
  price4       Float? // BK - Valor Cuota 4
  price5       Float? // BL - Valor Cuota 5
  price6       Float? // BM - Valor Cuota 6
  price7       Float? // BN - Valor Cuota 7
  price8       Float? // BO - Valor Cuota 8
  price9       Float? // BP - Valor Cuota 9
  price10      Float? // BQ - Valor Cuota 10
  price11      Float? // BR - Valor Cuota 11
  price12      Float? // BS - Valor Cuota 12
  price13      Float? // BT - Valor Cuota 13
  price14      Float? // BU - Valor Cuota 14
  price15      Float? // BV - Valor Cuota 15
  price16      Float? // BW - Valor Cuota 16
  price17      Float? // BX - Valor Cuota 17
  price18      Float? // BY - Valor Cuota 18
  price19      Float? // BZ - Valor Cuota 19
  price20      Float? // CA - Valor Cuota 20
  price21      Float? // CB - Valor Cuota 21
  price22      Float? // CC - Valor Cuota 22
  price23      Float? // CD - Valor Cuota 23
  price24      Float? // CE - Valor Cuota 24
  price25      Float? // CF - Valor Cuota 25
  price26      Float? // CG - Valor Cuota 26
  price27      Float? // CH - Valor Cuota 27
  price28      Float? // CI - Valor Cuota 28
  price29      Float? // CJ - Valor Cuota 29
  price30      Float? // CK - Valor Cuota 30

  // Datos adicionales (cols CL..DA)
  safra         String? // CL - SAFRA
  productName   String? // CM - Producto
  fabricante    String? // CO - Fabricante
  subGrupo      String? // CP - Sub-Grupo
  categoria     String? // CQ - Categoria
  division      String? // CR - Division
  tipo          String? // CS - Tipo
  marca         String? // CT - Marca
  modelo        String? // CU - Modelo
  valorTecnico  Float? // CV - Valor Para Tecnico
  margenTecnico Float? // CW - Margen P/Tecnico
  coluna1       String? // CX - Coluna1
  coluna2       String? // CY - Coluna2
  stock         Int      @default(0) // CZ - Stock
  costSistema   Float? // DA - Costo sistema

  // Campos legados (compatibilidad catálogo vendedor)
  price       Float    @default(0) // = priceContado
  cost        Float    @default(0) // = costProd

  // Etiqueta de color asignada por el admin (persistente)
  // Valores: "verde" | "azul" | "dorado" | "rojo" | null
  // REGLA DE ORO: Una vez asignada, sobrevive a recargas, ediciones de celdas e importaciones Excel.
  // Solo se borra si el usuario la quita manualmente.
  etiquetaColor String?

  // Registro de trazabilidad: última edición manual del admin
  // Se actualiza automáticamente cada vez que el admin guarda una edición (PUT o etiqueta).
  // Sobrevive a importaciones Excel (no se toca en import route).
  // Se muestra como badge sobre el SKU en la tabla de gestión.
  ultimaEdicionAt  DateTime?
  ultimaEdicionPor  String?  // nombre o email del admin que editó

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems QuoteItem[]

  @@index([category])
  @@index([name])
  @@index([showInCatalog])
}

// ─── COSTOS EDITADOS POR EL ADMIN (guardados) ───
// Una fila por cada columna de COSTO que el admin editó a mano en la tabla
// del Panel ADM y guardó. Valores de colKey: "costBR", "costUS", "costGs",
// "discountPct", "addPct", "admPct", "valorDesc", "valorAdd".
// Sirve para dos cosas (pedido del usuario):
//   1) Pintar de DORADO VIBRANTE la celda del costo editado (discernirlo de
//      un costo traído por importación).
//   2) Proteger esos costos al importar: los productos con costos editados
//      y guardados SOLO actualizan STOCK cuando se importa la planilla de
//      stock — el costo editado por el admin nunca se pisa.
// TABLA SEPARADA A PROPÓSITO (lección de la versión anterior): el resto de
// la app consulta Product con findMany SIN select, así que una columna
// nueva dentro de Product rompía TODAS esas consultas si `npx prisma db
// push` no se había ejecutado antes (columna inexistente en la BD → la
// lista de productos no cargaba y el saldo se veía en 0). Con una tabla
// aparte, el modelo Product queda intocado: si esta tabla todavía no
// existe, el código que la usa falla en silencio (try/catch) y la app
// funciona exactamente igual que antes; cuando se ejecuta el db push, se
// activan el dorado y la protección. Se llena al guardar una edición
// (PUT /api/products/[id]). Nunca se borra automáticamente.
model CostoEditado {
  id        String   @id @default(cuid())
  productId String // Product.id — sin relación Prisma a propósito: tocar el
                   // modelo Product (columna nueva) es lo que rompía la app
                   // cuando el db push no se había ejecutado.
  colKey    String
  createdAt DateTime @default(now())

  @@unique([productId, colKey])
}

// ============================================================
// #HASHTAG por producto (promo cargada por el admin):
// valor en Gs (ej: 100000) + fecha de validez ("YYYY-MM-DD",
// calendario del input date). El vendedor la ve al buscar el
// producto: "# 100.000 GS valido hasta 30/11/2026".
// TABLA APARTE A PROPÓSITO (misma lección de CostoEditado): el
// modelo Product queda EXACTAMENTE igual que siempre, así que
// NINGUNA consulta existente puede romperse. Si esta tabla
// todavía no existe en la base, el código que la usa falla en
// silencio (try/catch) y la app funciona igual que antes; se
// crea SOLA en el primer uso (SQL idempotente en
// src/lib/producto-hashtag.ts) o al correr `npx prisma db push`.
// Sin relación Prisma a propósito, por el mismo motivo que
// CostoEditado.
// ============================================================
model ProductHashtag {
  id        String   @id @default(cuid())
  productId String   @unique
  valor     Float?
  fecha     String?  // "YYYY-MM-DD" (input date) → se muestra DD/MM/YYYY
  updatedAt DateTime @updatedAt
}

// ============================================================
// CAPACIDAD POR PRODUCTO (Task 97, pedido del dueño)
// Columna NUEVA "CAPACIDAD" de la Base (texto libre: "12.000 BTU",
// "650M3H", "90CM"...). El dato no existía ni en la planilla ni en la
// base. MISMO PATRÓN que ProductHashtag: tabla APARTE para no tocar el
// modelo Product (lección de la casa: columnas nuevas en Product
// rompían la app cuando el db push no se había ejecutado). Se muestra
// en la tabla entre MODELO y REF.FABRICA, es editable, se puede filtrar
// y buscar. Si la tabla falta, se crea SOLA en el primer uso (SQL
// idempotente en src/lib/producto-capacidad.ts) o al correr
// `npx prisma db push`. Sin relación Prisma a propósito, por el mismo
// motivo que CostoEditado.
// ============================================================
model ProductCapacidad {
  id        String   @id @default(cuid())
  productId String   @unique
  valor     String?
  updatedAt DateTime @updatedAt
}

// ============================================================
// CORES POR PRODUCTO (Task 98, pedido del dueño)
// Columna NUEVA "CORES" de la Base (texto libre: colores del
// producto, ej: "BRANCO/AZUL", "PRETO", "CINZA"...). Queda entre
// MODELO y CAPACIDAD en la tabla. MISMO PATRÓN que ProductCapacidad
// y ProductHashtag: tabla APARTE para no tocar el modelo Product
// (lección de la casa: columnas nuevas en Product rompían la app
// cuando el db push no se había ejecutado). Es editable, se puede
// filtrar y buscar. Si la tabla falta, se crea SOLA en el primer
// uso (SQL idempotente en src/lib/producto-cores.ts) o al correr
// `npx prisma db push`. Sin relación Prisma a propósito, por el
// mismo motivo que CostoEditado.
// ============================================================
model ProductCores {
  id        String   @id @default(cuid())
  productId String   @unique
  valor     String?
  updatedAt DateTime @updatedAt
}

// ============================================================
// ETIQUETAS DE COLOR CREADAS POR EL SUPREMO (Task 84)
// Etiquetas ADICIONALES a las 4 fijas de siempre (verde, azul,
// dorado, rojo). El supremo_admin las crea con el botón CREAR
// ETIQUETA de la Base: nombre visible + color "#RRGGBB".
// El producto guarda en su columna etiquetaColor (LA MISMA DE
// SIEMPRE) el id de la etiqueta — así los filtros, la edición y
// las importaciones siguen funcionando exactamente igual.
// TABLA AUTO-GESTIONADA (mismo patrón que CostoEditado y
// ProductHashtag, ver src/lib/etiquetas.ts): se crea sola en el
// primer uso y NUNCA rompe la app.
// ============================================================
model Etiqueta {
  id        String   @id @default(cuid())
  nombre    String   @unique
  color     String   // "#RRGGBB"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── SUCURSAL ASIGNADA A CADA USUARIO (CRM · ranking) ───
// Una fila por usuario (clave = email) con la sucursal que le asigna el
// admin. La usa el CRM: ranking de presupuestos emitidos por usuario,
// general y por sucursal.
// Se siembra AUTOMÁTICAMENTE desde la planilla oficial de funcionarios
// (FUN.VIZA: email → sucursal) y el admin puede cambiarla a mano con el
// select del panel CRM.
// TABLA APARTE A PROPÓSITO (misma lección de CostoEditado): el modelo User
// queda EXACTAMENTE igual que siempre, así que NINGUNA consulta existente
// puede romperse. Si esta tabla todavía no existe en la base, el código
// que la usa falla en silencio (try/catch) y la app funciona igual que
// antes; se crea SOLA en el primer uso (SQL idempotente en
// src/lib/sucursal-usuario.ts) o al correr `npx prisma db push`.
// La clave es el EMAIL (estable y único en User) y no hay relación Prisma
// a propósito, por el mismo motivo que CostoEditado: tocar User (columna
// nueva) era lo que podía romper la app si el db push no se había corrido.
model UsuarioSucursal {
  id        String   @id @default(cuid())
  userEmail String   @unique
  sucursal  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TASA DE CAMBIO ACTIVA (Task 87, pedido del dueño)
// UNA sola fila (id "ACTIVA") con el cambio R$→Gs y US$→Gs que
// usa TODO el sistema al recalcular costos y precios. Antes
// esas tasas vivían fijas en el código (1100 / 6000); ahora el
// supremo las edita desde la Base (botón TASA DE CAMBIO) y las
// aplica a la base general.
// El modelo Product NO se toca: los costos de entrada
// (costBR / costUS / costGs) y todos los registros quedan igual
// que siempre — la tasa solo alimenta las fórmulas de siempre
// (D = C * cambio, F = E * cambio, ...).
// TABLA AUTO-GESTIONADA (mismo patrón que CostoEditado y
// ProductHashtag, ver src/lib/tasas-cambio.ts): se crea sola en
// el primer uso y NUNCA rompe la app; si la lectura falla, el
// sistema vuelve a las tasas de siempre (1100 / 6000).
// ============================================================
model TasaCambio {
  id             String   @id // "ACTIVA" (fila única de configuración)
  cambioRS       Float    @default(1100) // R$ → Gs
  cambioUS       Float    @default(6000) // US$ → Gs
  updatedAt      DateTime @updatedAt
  actualizadoPor String   @default("SISTEMA")
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  customerAddress String?
  vendorName    String      @default("Vendedor VIZA")
  notes         String?
  subtotal      Float
  discount      Float       @default(0)
  taxRate       Float       @default(0) // Porcentaje IVA
  total         Float
  status        String      @default("borrador") // borrador, enviada, aprobada, rechazada
  userId        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items QuoteItem[]
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model QuoteItem {
  id         String   @id @default(cuid())
  quoteId    String
  productId  String
  productName String
  productSku String
  quantity   Int      @default(1)
  unitPrice  Float
  subtotal   Float
  createdAt  DateTime @default(now())

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

// ============================================================
// Contador SECUENCIAL de presupuestos por (plan, usuario).
// Ej: MAYOR-01, MAYOR-02, MAYOR-03 ... SAFRA-01 ... CHEQUE-01 ...
// Cada usuario lleva SU PROPIA cuenta para cada tipo de plan:
// el numero 01 de MAYOR del vendedor A es independiente del 01
// de MAYOR del vendedor B.
// userId es un string simple (sin relacion) para conservar la
// cuenta historica aunque el usuario sea eliminado.
// ============================================================
model QuoteSequence {
  id         String   @id @default(cuid())
  plan       String   // "PRESUPUESTO" | "MAYOR" | "SAFRA" | "CHEQUE"
  userId     String   // id del usuario vendedor (o "SIN-USUARIO")
  lastNumber Int      @default(0) // ultimo numero entregado
  updatedAt  DateTime @updatedAt

  @@unique([plan, userId])
}

// ============================================================
// STOCK POR SUCURSAL (Task 98, pedido del dueño)
// "tenemos que hacer um filtro para poder ver por sucursal... lo que
// esta Central es nuestro deposito Central y los otros son por cada
// sucursal... tenemos que dividir bien".
// El inventario del ERP (grid_inventario_stock_new) trae la columna
// SUCURSAL: CENTRAL = depósito central; KATUETE / NUEVA ESPERANZA /
// SALTOS DEL GUAIRA / LA PALOMA = sucursales de venta. Una fila por
// (producto, sucursal) con el SALDO entero de esa planilla.
// El Product.stock global de SIEMPRE sigue existiendo y se sigue
// llenando con la suma total del Excel (intacto).
// TABLA APARTE A PROPÓSITO (misma lección de CostoEditado /
// ProductHashtag / ProductCapacidad): el modelo Product queda
// EXACTAMENTE igual que siempre, así que NINGUNA consulta existente
// puede romperse. Si esta tabla todavía no existe en la base, el
// código que la usa falla en silencio (try/catch) y la app funciona
// igual que antes; se crea SOLA en el primer uso (SQL idempotente en
// src/lib/stock-sucursal.ts) o al correr `npx prisma db push`.
// Sin relación Prisma a propósito, por el mismo motivo que
// CostoEditado: tocar Product (columna nueva) era lo que rompía la
// app cuando el db push no se había ejecutado.
// ============================================================
model StockSucursal {
  id        String   @id @default(cuid())
  productId String   // Product.id (sin relación a propósito, ver arriba)
  sucursal  String   // "CENTRAL" | "KATUETE" | "NUEVA ESPERANZA" | ... (tal cual el ERP)
  saldo     Float    @default(0) // parte entera del Saldo de la planilla (1.0000 → 1)
  updatedAt DateTime @updatedAt

  @@unique([productId, sucursal])
  @@index([sucursal])
}

// ============================================================
// STOCK IDEAL POR PRODUCTO Y SUCURSAL (Task 127, pedido del dueño)
// Módulo de DISTRIBUCIÓN INTELIGENTE DE INVENTARIO: el dueño define
// CUÁNTO debería haber de cada producto en cada nodo (CENTRAL y cada
// sucursal). Con eso el sistema calcula quién SOBRA (saldo > ideal =
// excedente) y quién FALTA (saldo < ideal = déficit) y arma el
// reporte de TRANSFERENCIAS INTERNAS (de donde sobra a donde falta —
// NUNCA órdenes de compra a proveedores).
// MISMO patrón que StockSucursal: tabla aparte (sin relación a
// Product a propósito), UNIQUE(productId, sucursal) y AUTO-GESTIONADA
// en src/lib/stock-ideal.ts (si la tabla no existe, la primera
// operación la crea sola con SQL idempotente — jamás rompe la app).
// ============================================================
model ProductStockIdeal {
  id        String   @id @default(cuid())
  productId String   // Product.id (sin relación a propósito, mismo motivo que arriba)
  sucursal  String   // "CENTRAL" | "KATUETE" | "NUEVA ESPERANZA" | ... (tal cual StockSucursal)
  ideal     Float    @default(0) // cuántas unidades DEBERÍA haber en ese nodo
  updatedAt DateTime @updatedAt

  @@unique([productId, sucursal])
  @@index([sucursal])
}

// ============================================================
// Task 105 (pedido del dueño): REGISTRO DE IMPORTACIONES DE STOCK.
// "cada vez que yo suba el excel para actualizar stock y agregar nuevos
// productos seria importante que lo equipo tenga esto informado en su
// panel... cantidad de productos nuevos agregados y horario de
// actualizacion de stock... mini cuadrito lado izquierdo nel panel de
// ventas".
// UNA fila por importación aplicada (import-stock/apply): fecha/hora,
// cuántos productos NUEVOS se agregaron y cuántos existentes se
// actualizaron. El panel de ventas lee la última fila vía
// GET /api/stock-import-info y la muestra en el mini cuadrito del header.
// TABLA APARTE, sin relación a Product (misma lección de CostoEditado /
// StockSucursal): tocar Product era lo que rompía la app. Si la tabla no
// existe todavía, el código que la usa falla en silencio (try/catch) y
// la app funciona igual que siempre; se crea SOLA en el primer uso (SQL
// idempotente en src/lib/stock-import-log.ts) o al correr
// `npx prisma db push`.
// ============================================================
model StockImportLog {
  id            String   @id @default(cuid())
  fecha         DateTime @default(now()) // momento de la importación aplicada
  nuevos        Int      @default(0) // productos NUEVOS agregados por la planilla
  actualizados  Int      @default(0) // productos existentes actualizados (stock/costo)
  usuarioEmail  String?  // quién aplicó la importación (informativo)
}

// ============================================================
// PEDIDO ESPECIAL (Task 113, pedido del dueño)
// "nel panel del cotizador necesitamos crear una opcion para cotizar
//  el PEDIDO ESPECIAL... pone el costo, selecciona el proveedor y el
//  tipo de producto, escribe la descripcion, elige el tipo de plan y
//  de acuerdo al % de nuestra base para aquel tipo de producto y
//  proveedor genera el plan".
// UNA fila por combinación (PROVEEDOR + TIPO DE PRODUCTO) con los %
// que el admin carga en la Base — la MISMA estructura de % que los
// productos de la BASE:
//   pctContado = % CONTADO (como col AB)
//   pct1A6     = % 1 A 6   (como col Y)
//   pct7A13    = % 7 A 13  (como col Z)
//   pct14A30   = % 14 A 30 (como col AA)
// El vendedor NO escribe ningún %: elige proveedor + tipo y el sistema
// aplica los % de acá con la MISMA fórmula de la BASE (márgenes
// acumulativos por tramo + redondeo a miles) para calcular el plan.
// TABLA APARTE A PROPÓSITO (misma lección de CostoEditado /
// ProductHashtag / TasaCambio): el modelo Product queda EXACTAMENTE
// igual que siempre, así que NINGUNA consulta existente puede
// romperse. Si esta tabla todavía no existe en la base, el código que
// la usa falla en silencio (try/catch) y la app funciona igual que
// antes; se crea SOLA en el primer uso (SQL idempotente en
// src/lib/pedido-especial.ts) o al correr `npx prisma db push`.
// Sin relación Prisma a propósito, por el mismo motivo que
// CostoEditado: tocar Product (columna nueva) era lo que rompía la
// app cuando el db push no se había ejecutado.
// ============================================================
model PedidoEspecialConfig {
  id           String   @id @default(cuid())
  proveedor    String // "GAFRA", "SHOW", ... (lista derivada de estas filas)
  tipoProducto String // "MOTOS", "ELECTRO", ...
  // % como NÚMEROS LEGIBLES (10 = 10%, 2.5 = 2.5%) — lo que el admin
  // escribe en el modal de la Base. El cálculo divide por 100
  // (src/lib/pedido-especial-calc.ts); ojo: en Product los márgenes
  // van como FRACCIÓN (0.10 = 10%) — unidades distintas a propósito.
  pctContado   Float    @default(0) // % CONTADO (como col AB de la BASE)
  pct1A6       Float    @default(0) // % 1 A 6   (como col Y)
  pct7A13      Float    @default(0) // % 7 A 13  (como col Z)
  pct14A30     Float    @default(0) // % 14 A 30 (como col AA)
  // Task 113 v2 (todos los planes del sistema):
  pctTecnico   Float    @default(0) // % TÉCNICO para MAYORISTA (como col CW
                                        // "Margen P/Tecnico" de la BASE: valor
                                        // técnico = Costo Gs × (1 + %/100))
  pctSafra     Float    @default(0) // % SAFRA = tasa de INTERÉS MENSUAL sobre
                                        // el saldo restante (como col CL de la
                                        // BASE: 7 = 7% mensual)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([proveedor, tipoProducto])
}

// ============================================================
// HISTORIAL de presupuestos del PEDIDO ESPECIAL (Task 113 v3,
// pedido del dueño): "los encargados de sucursales quiero que
// ellos puedan ver el historico de presupuestos de pedido
// especial generados… y la situación de los mismos, si fue
// generado y si está como aprobado… el vendedor va a tener una
// opción de marcar como aprobado".
//
// Cada presupuesto que el vendedor GUARDA desde la pantalla PEDIDO
// ESPECIAL queda acá con su SITUACIÓN:
//   · GENERADO → recién guardado (el cálculo quedó congelado)
//   · APROBADO → el vendedor lo marcó aprobado; el encargado de su
//     sucursal lo ve como aprobado en el historial.
// Task 113 v5 (pedido del dueño): para MARCAR APROBADO el campo ID CTR
// es OBLIGATORIO: ahí el vendedor anota el N° de CRÉDITO con el que
// salió el pedido, y el encargado de sucursal lo verifica después
// (queda guardado en `idCtr` y se muestra en el historial).
// El encargado de sucursal (lista ENCARGADOS_SUCURSAL) ve el historial
// de TODAS las sucursales con FILTRO por sucursal (Task 113 v6: por
// defecto ve la SUYA para facilitar); el vendedor ve el propio con el
// botón MARCAR APROBADO; admin/supremo ven todo.
//
// FLUJO DE ESTADOS (Task 113 v6, pedido del dueño):
//   GENERADO (vendedor guarda)
//     → APROBADO (vendedor, con ID CTR obligatorio)
//     → VERIFICADO (encargado de la sucursal — "primer el marca VERIFICADO")
//     → ORDEN DE COMPRA (el encargado genera la orden de compra en PDF
//       de ese presupuesto específico; queda numerada OC-01, OC-02…).
//
// TABLA AUTO-GESTIONADA igual que PedidoEspecialConfig: se crea
// SOLA en el primer uso (SQL idempotente en
// src/lib/pedido-especial-presupuestos.ts) y NUNCA toca tablas
// existentes. Sin relaciones Prisma a propósito (mismo motivo).
//
// Los números salen de QuoteSequence con plan "ESPECIAL" (misma
// mecánica de MAYOR-01 / SAFRA-01 / CHEQUE-01: ESPECIAL-01, 02…,
// cuenta PROPIA por usuario).
// ============================================================
model PedidoEspecialPresupuesto {
  id             String    @id @default(cuid())
  numero         String    @unique // "ESPECIAL-01", "ESPECIAL-02"...
  vendedorEmail  String // email de quien lo generó (minúscula)
  vendedorNombre String    @default("") // nombre del vendedor (para el encargado)
  sucursal       String    @default("") // sucursal del vendedor (snapshot UsuarioSucursal)
  proveedor      String
  tipoProducto   String
  descripcion    String    @default("")
  modoCosto      String    @default("gs") // "usd" | "gs" (moneda del costo original)
  costoOriginal  Float // costo tal cual lo puso el vendedor (US$ o Gs)
  costoGs        Float // costo convertido a Gs
  cambioUS       Float     @default(0) // tasa activa usada si modoCosto = usd
  plan           String // contado | cuotas_con_entrega | cuotas_sin_entrega | mayorista | safra | cheque
  cuotas         Int       @default(0)
  // % APLICADOS (snapshot de la combinación de la Base en el momento
  // del cálculo — quedan congelados acá para que el historial muestre
  // SIEMPRE el mismo número, aunque el admin cambie los % después).
  pctContado     Float     @default(0)
  pct1A6         Float     @default(0)
  pct7A13        Float     @default(0)
  pct14A30       Float     @default(0)
  pctTecnico     Float     @default(0)
  pctSafra       Float     @default(0)
  valorContado   Float     @default(0)
  cuotaValor     Float     @default(0)
  valorTecnico   Float     @default(0)
  total          Float // monto principal del plan (lo grande de la pantalla)
  totalIntereses Float     @default(0) // SAFRA
  // Desglose COMPLETO del cálculo en JSON (cronograma SAFRA, cheques,
  // fecha de inicio sin entrega, entrada, recargo, tasa, etc.) para
  // poder re-mostrar el plan idéntico más adelante.
  detalle        String    @default("")
  estado         String    @default("GENERADO") // GENERADO | APROBADO | VERIFICADO
  // Task 113 v5 (pedido del dueño): N° de CRÉDITO ("ID CTR") que el
  // vendedor ESCRIBE OBLIGATORIAMENTE al marcar el presupuesto como
  // APROBADO — después el encargado de sucursal lo verifica. Va vacío
  // mientras el presupuesto está GENERADO.
  idCtr          String    @default("")
  fechaAprobado  DateTime?
  // Task 113 v6 (pedido del dueño): el ENCARGADO de la sucursal marca
  // VERIFICADO el presupuesto APROBADO (con el ID CTR a la vista) y
  // después GENERA LA ORDEN DE COMPRA de ese presupuesto específico.
  fechaVerificado     DateTime?
  verificadoPorEmail  String    @default("")
  verificadoPorNombre String    @default("")
  ordenGenerada       Boolean   @default(false)
  ordenNumero         String    @default("") // "OC-01", "OC-02"… (QuoteSequence plan "OC")
  ordenFecha          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendedorEmail])
  @@index([sucursal])
}

// ─── PEDIDO ESPECIAL — TIPOS DE PRODUCTO CREADOS POR EL VENDEDOR ───
// Task 113 v6 (pedido del dueño): "en tipo de producto quiero que tenga
// opción de crear también si es que no tenemos catalogado este tipo de
// producto". Los tipos de la BASE salen de la columna TIPO de Product
// (DISTINCT); los tipos que alguien CREA desde la pantalla (porque no
// existen todavía) viven acá y aparecen SIEMPRE en el dropdown, para
// todos los proveedores. El cálculo de un tipo nuevo usa el promedio
// GENERAL de la BASE (cascada par → proveedor → tipo → general: no hay
// productos de ese tipo todavía, así que cae al general).
// TABLA AUTO-GESTIONADA (mismo patrón): CREATE TABLE IF NOT EXISTS en
// src/lib/pedido-especial.ts — sin pasos manuales, nunca rompe la app.
model PedidoEspecialTipo {
  id        String   @id @default(cuid())
  nombre    String   @unique // "ELECTRO", "HERRAMIENTAS"… (mayúsculas)
  createdBy String   @default("") // email de quien lo creó (referencia)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
